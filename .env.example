# 这是本地开发模板；生产部署必须显式设置 ZHUZHANG_APP_ENV=production。
# APP_ENV 仍兼容本地旧配置，但部分云平台会把它占作系统变量。
ZHUZHANG_APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# 默认不注入演示项目；只允许在空的本地开发库中临时设为 true。
SEED_DEMO_ENABLED=false
# 生产示例：postgresql+psycopg://app_user:password@postgres:5432/renovation_budget
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# 数据库切换窗口设置为 true 时，API 拒绝所有写请求并返回 Retry-After。
MAINTENANCE_MODE=false
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_PREFIX=database-backups
DATABASE_BACKUP_INTERVAL_SECONDS=300
DATABASE_BACKUP_MAX_AGE_SECONDS=900
DATABASE_BACKUP_RETENTION_COUNT=24
DATABASE_BACKUP_REQUIRE_READY=false
MAINTENANCE_CLEANUP_ENABLED=true
MAINTENANCE_CLEANUP_INTERVAL_SECONDS=600
MAINTENANCE_STAGING_MAX_AGE_SECONDS=86400
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
SOURCE_STORAGE_BACKEND=local
SOURCE_STORAGE_PREFIX=project-files
SOURCE_STORAGE_PRESIGN_SECONDS=300
# 关闭后报价和证据上传返回 503；其他功能可继续使用。
UPLOADS_ENABLED=true
# 上传默认上限：单文件 30 MB、每项目 200 个文件/1 GiB。
# 生产开启上传时必须接入 ClamAV；设为 false 时可保持扫描模式 disabled。
UPLOAD_MAX_FILE_BYTES=31457280
UPLOAD_PROJECT_MAX_FILES=200
UPLOAD_PROJECT_MAX_BYTES=1073741824
UPLOAD_ZIP_MAX_ENTRIES=2000
UPLOAD_ZIP_MAX_ENTRY_BYTES=52428800
UPLOAD_ZIP_MAX_TOTAL_BYTES=209715200
UPLOAD_IMAGE_MAX_PIXELS=50000000
UPLOAD_MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
# 上传扫描允许更长的处理时间；就绪探针需快速失败，避免平台迟迟不摘流。
CLAMAV_TIMEOUT_SECONDS=10
CLAMAV_READINESS_TIMEOUT_SECONDS=2
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_BUCKET=
ARTIFACT_STORAGE_PREFIX=project-exports
ARTIFACT_STORAGE_REGION=
ARTIFACT_STORAGE_ENDPOINT_URL=
ARTIFACT_STORAGE_ACCESS_KEY_ID=
ARTIFACT_STORAGE_SECRET_ACCESS_KEY=
ARTIFACT_STORAGE_PRESIGN_SECONDS=300
ARTIFACT_STORAGE_SSE=AES256

# 本地默认内嵌执行；生产设置为 worker，并单独启动 backend/export_worker.py。
EXPORT_EXECUTION_MODE=embedded
EXPORT_PART_SIZE_MB=100
EXPORT_JOB_LEASE_SECONDS=3600
EXPORT_JOB_MAX_ATTEMPTS=3
EXPORT_RETRY_BASE_SECONDS=30
EXPORT_WORKER_POLL_SECONDS=2

# 报价解析独立 Worker。生产设置为 worker，并单独启动 backend/quote_worker.py。
QUOTE_EXECUTION_MODE=embedded
QUOTE_JOB_LEASE_SECONDS=3600
QUOTE_JOB_MAX_ATTEMPTS=3
QUOTE_RETRY_BASE_SECONDS=30
QUOTE_WORKER_POLL_SECONDS=2

# 两类 Worker 共用的存活心跳与就绪判定。
WORKER_HEARTBEAT_SECONDS=5
WORKER_HEARTBEAT_STALE_SECONDS=20
# 合并 Worker 服务可同时消费两个队列，veFaaS 启动命令：python worker_service_bootstrap.py
WORKER_QUEUES=quote,export
WORKER_REQUIRE_POSTGRESQL=false
WORKER_FAILURE_BACKOFF_SECONDS=5
WORKER_SHUTDOWN_SECONDS=10
HEALTH_REQUIRE_WORKERS=false
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
TRUSTED_PROXY_CIDRS=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1

# 正式账号与会话。本地 development 模式会把验证码仅返回给登录页。
AUTH_SECRET=local-development-only-change-before-production
AUTH_DELIVERY_MODE=development
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_DEMO_HEADER=false
AUTH_SESSION_DAYS=30
AUTH_CODE_MINUTES=10
AUTH_RECENT_MINUTES=15

# 生产邮件投递：AUTH_DELIVERY_MODE=smtp 后填写，不需要额外 API Key。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true

# 扫描报价单 AI 解析（Key 只写入本机 .env 或部署 Secret）
AI_ENABLED=false
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PRIMARY_MODEL=qwen3.6-flash-2026-04-16
QWEN_FALLBACK_MODEL=qwen3.7-plus-2026-05-26
QWEN_OCR_MODEL=qwen3.5-ocr
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_PAGES=20
AI_MAX_RETRIES=2
